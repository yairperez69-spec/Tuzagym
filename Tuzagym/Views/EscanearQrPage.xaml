<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
    x:Class="Tuzagym.Views.EscanearQrPage"
    Title="Escanear asistencia"
    BackgroundColor="#0B0F19">

    <Grid
        RowDefinitions="Auto,*,Auto"
        RowSpacing="20"
        Padding="20">

        <!-- ENCABEZADO -->
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="8">

            <Label
                Text="ESCANEAR ASISTENCIA"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="#00E676"
                HorizontalTextAlignment="Center"/>

            <Label
                Text="Coloca el código QR del socio frente a la cámara."
                TextColor="#CBD5E1"
                FontSize="14"
                HorizontalTextAlignment="Center"/>

        </VerticalStackLayout>

        <!-- CÁMARA -->
        <Border
            Grid.Row="1"
            Stroke="#00E676"
            StrokeThickness="2"
            StrokeShape="RoundRectangle 18"
            BackgroundColor="#151E2C">

            <Grid>
                <Grid x:Name="ContenedorCamara"
      HorizontalOptions="Fill"
      VerticalOptions="Fill" />

                <Border
                    Stroke="#00E676"
                    StrokeThickness="2"
                    BackgroundColor="Transparent"
                    WidthRequest="230"
                    HeightRequest="230"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    InputTransparent="True"
                    StrokeShape="RoundRectangle 16"/>
            </Grid>

        </Border>

        <!-- RESULTADO -->
        <VerticalStackLayout
            Grid.Row="2"
            Spacing="12">

            <Label
                x:Name="EstadoLabel"
                Text="Esperando código QR..."
                TextColor="White"
                FontSize="14"
                HorizontalTextAlignment="Center"/>

            <Button
                Text="VOLVER A RECEPCIÓN"
                Clicked="Volver_Clicked"
                BackgroundColor="#253248"
                TextColor="White"
                HeightRequest="52"
                CornerRadius="12"/>

        </VerticalStackLayout>

    </Grid>

</ContentPage>
