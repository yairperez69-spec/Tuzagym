<?xml version="1.0" encoding="utf-8" ?>
<ContentPage NavigationPage.HasNavigationBar="False"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tuzagym.Views.AdminHomePage"
             Title="Administración" BackgroundColor="#07111B">
    <Grid RowDefinitions="*,Auto">
        <!-- Fondo fijo: se recorta sin deformarse al cambiar el tamaño de pantalla. -->
        <Image Grid.RowSpan="2" Source="fondo_gym.png" Aspect="AspectFill" InputTransparent="True" />
        <BoxView Grid.RowSpan="2" Color="#B30B0F19" InputTransparent="True" />


        <ScrollView
    x:Name="PanelScroll"
    Grid.Row="0"
    BackgroundColor="Transparent"
    HorizontalScrollBarVisibility="Never">

            <VerticalStackLayout Padding="{OnIdiom Phone='14,20,14,26', Default='24,28,24,32'}"
                                 Spacing="20" MaximumWidthRequest="940" HorizontalOptions="Center">
                <!-- Marca -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="2,0">
                    <Border BackgroundColor="#103D30" Stroke="#00E676" StrokeThickness="1"
                            StrokeShape="RoundRectangle 12" Padding="12,8">
                        <Label Text="▰" TextColor="#00E676" FontSize="22" FontAttributes="Bold" VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="TUZAGYM" FontSize="23" FontAttributes="Bold" TextColor="#00E676" />
                        <Label Text="ADMINISTRACIÓN" FontSize="10" CharacterSpacing="2" TextColor="White" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Cabecera -->
                <Border BackgroundColor="#E00D1D29" Stroke="#376A72" StrokeThickness="1"
                        StrokeShape="RoundRectangle 23" Padding="{OnIdiom Phone=17, Default=23}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="7">
                            <Label Text="TUZAGYM / ADMINISTRADOR" FontSize="11" FontAttributes="Bold" TextColor="#00E676" />
                            <Label Text="Panel general" FontSize="{OnIdiom Phone=25, Default=30}"
                                   FontAttributes="Bold" TextColor="White" LineBreakMode="WordWrap" />
                            <Label Text="Personal, caja y finanzas" FontSize="12" TextColor="#B7C8D4" />
                        </VerticalStackLayout>

                        <!-- LOGO OFICIAL DE TUZAGYM -->
                        <Border
    Grid.Column="1"
    BackgroundColor="#123D30"
    Stroke="#00E676"
    StrokeThickness="1"
    StrokeShape="RoundRectangle 14"
    Padding="6"
    VerticalOptions="Center"
    HorizontalOptions="End">

                            <Image
        Source="logo_tuza.png"
        WidthRequest="{OnIdiom Phone=44, Default=58}"
        HeightRequest="{OnIdiom Phone=44, Default=58}"
        Aspect="AspectFit"
        HorizontalOptions="Center"
        VerticalOptions="Center" />

                        </Border>

                    </Grid>
                </Border>

                <Label Text="▥  RESUMEN FINANCIERO" TextColor="White" FontAttributes="Bold" FontSize="17" />
                <!-- 2 columnas fluidas en móvil y escritorio; nunca se fuerza un ancho fijo. -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#E0102930" Stroke="#00B66B"
                            StrokeThickness="1.5" StrokeShape="RoundRectangle 19" Padding="{OnIdiom Phone=13, Default=20}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="↗" TextColor="#00E676" FontSize="26" FontAttributes="Bold" />
                            <Label Text="{Binding VentasMes}" TextColor="#00E676" FontSize="{OnIdiom Phone=21, Default=27}"
                                   FontAttributes="Bold" LineBreakMode="TailTruncation" />
                            <Label Text="Ventas del mes" TextColor="#CFDDE3" FontSize="{OnIdiom Phone=11, Default=13}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#E00C2638" Stroke="#00BCEB"
                            StrokeThickness="1.5" StrokeShape="RoundRectangle 19" Padding="{OnIdiom Phone=13, Default=20}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="◈" TextColor="#22D3EE" FontSize="26" />
                            <Label Text="{Binding GananciaMes}" TextColor="#22D3EE" FontSize="{OnIdiom Phone=21, Default=27}"
                                   FontAttributes="Bold" LineBreakMode="TailTruncation" />
                            <Label Text="Ganancia del mes" TextColor="#CFDDE3" FontSize="{OnIdiom Phone=11, Default=13}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#E02B2414" Stroke="#E8AD25"
                            StrokeThickness="1.5" StrokeShape="RoundRectangle 19" Padding="{OnIdiom Phone=13, Default=20}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="▤" TextColor="#FBBF24" FontSize="26" />
                            <Label Text="{Binding GastosMes}" TextColor="#FBBF24" FontSize="{OnIdiom Phone=21, Default=27}"
                                   FontAttributes="Bold" LineBreakMode="TailTruncation" />
                            <Label Text="Gastos del mes" TextColor="#CFDDE3" FontSize="{OnIdiom Phone=11, Default=13}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#E0211836" Stroke="#9A5DE5"
                            StrokeThickness="1.5" StrokeShape="RoundRectangle 19" Padding="{OnIdiom Phone=13, Default=20}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="▣" TextColor="#C084FC" FontSize="26" />
                            <Label Text="{Binding SaldoCaja}" TextColor="White" FontSize="{OnIdiom Phone=21, Default=27}"
                                   FontAttributes="Bold" LineBreakMode="TailTruncation" />
                            <Label Text="Saldo de caja" TextColor="#CFDDE3" FontSize="{OnIdiom Phone=11, Default=13}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border BackgroundColor="#E00C2530" Stroke="#28666B" StrokeShape="RoundRectangle 18" Padding="15">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Text="▣" TextColor="#00E676" FontSize="26" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="Estado de caja" TextColor="#CFDDE3" FontSize="12" />
                            <Label Text="{Binding EstadoCaja}" TextColor="#00E676" FontAttributes="Bold" FontSize="17" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2" Text="⟳ Actualizar" Clicked="OnActualizarClicked"
                                BackgroundColor="#114A36" BorderColor="#00E676" BorderWidth="1"
                                TextColor="White" FontSize="12" CornerRadius="12" HeightRequest="45" Padding="12,0" />
                    </Grid>
                </Border>
                <Label Text="{Binding MensajeEstado}" TextColor="#D0D9E1" FontSize="11" HorizontalTextAlignment="Center" />

                <!-- Finanzas: accesos directos con área táctil amplia. -->
                <Label x:Name="TituloFinanzas" Text="▱  CONTROL FINANCIERO" TextColor="White" FontAttributes="Bold" FontSize="17" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#E0102432" Stroke="#427589"
                            StrokeShape="RoundRectangle 17" Padding="3">
                        <Button Text="▣  Arqueo y cierre de caja  ›" Clicked="OnCierreCajaClicked"
                                BackgroundColor="Transparent" TextColor="White" FontAttributes="Bold"
                                FontSize="{OnIdiom Phone=12, Default=15}" CornerRadius="14"
                                HeightRequest="{OnIdiom Phone=92, Default=88}" />
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#E0102432" Stroke="#B9852D"
                            StrokeShape="RoundRectangle 17" Padding="3">
                        <Button Text="▤  Registrar gastos  ›" Clicked="OnRegistrarGastosClicked"
                                BackgroundColor="Transparent" TextColor="White" FontAttributes="Bold"
                                FontSize="{OnIdiom Phone=12, Default=15}" CornerRadius="14"
                                HeightRequest="{OnIdiom Phone=92, Default=88}" />
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#E0102432" Stroke="#3287B7"
                            StrokeShape="RoundRectangle 17" Padding="3">
                        <Button Text="▥  Ganancias mensuales  ›" Clicked="OnGananciasClicked"
                                BackgroundColor="Transparent" TextColor="White" FontAttributes="Bold"
                                FontSize="{OnIdiom Phone=12, Default=15}" CornerRadius="14"
                                HeightRequest="{OnIdiom Phone=92, Default=88}" />
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#E0102432" Stroke="#C35475"
                            StrokeShape="RoundRectangle 17" Padding="3">
                        <Button Text="▤  Reportes y comisiones  ›" Clicked="OnReporteClicked"
                                BackgroundColor="Transparent" TextColor="White" FontAttributes="Bold"
                                FontSize="{OnIdiom Phone=12, Default=15}" CornerRadius="14"
                                HeightRequest="{OnIdiom Phone=92, Default=88}" />
                    </Border>
                </Grid>

                <Label x:Name="TituloPersonal" Text="♙  GESTIÓN DE PERSONAL" TextColor="White" FontAttributes="Bold" FontSize="17" />
                <Border BackgroundColor="#E011202F" Stroke="#355064" StrokeShape="RoundRectangle 19" Padding="16">
                    <VerticalStackLayout Spacing="11">
                        <Label Text="Administra los empleados del gimnasio." TextColor="#C3D0D9" FontSize="12" />
                        <Button Text="＋  REGISTRAR ENTRENADOR" Clicked="OnRegistrarEntrenadorClicked"
                                BackgroundColor="#008B5C" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="52" />
                        <Button Text="＋  REGISTRAR RECEPCIONISTA" Clicked="OnRegistrarRecepcionistaClicked"
                                BackgroundColor="#263B50" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="52" />
                        <Button Text="☷  CONSULTAR PERSONAL" Clicked="OnConsultarPersonalClicked"
                                BackgroundColor="#263B50" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="52" />
                    </VerticalStackLayout>
                </Border>
                <Button Text="Cerrar sesión" Clicked="OnCerrarSesionClicked" BackgroundColor="#273343"
                        TextColor="#FF728B" CornerRadius="13" HeightRequest="52" />
                <Label Text="TUZAGYM • SISTEMA DE GESTIÓN" TextColor="#9CA9B5" FontSize="10" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Barra inferior con navegación REAL dentro del ScrollView. -->
        <Border Grid.Row="1" BackgroundColor="#F00E1B2A" Stroke="#315266" StrokeThickness="1"
                StrokeShape="RoundRectangle 18" Padding="{OnIdiom Phone='6,8', Default='12,10'}">
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4" MaximumWidthRequest="940" HorizontalOptions="Center">
                <Button Grid.Column="0" Text="⌂ Inicio" Clicked="OnNavInicioClicked" BackgroundColor="#006F4A"
                        TextColor="White" CornerRadius="12" FontSize="{OnIdiom Phone=11, Default=14}" HeightRequest="50" Padding="3" />
                <Button Grid.Column="1" Text="♙ Personal" Clicked="OnNavPersonalClicked" BackgroundColor="Transparent"
                        TextColor="White" CornerRadius="12" FontSize="{OnIdiom Phone=11, Default=14}" HeightRequest="50" Padding="3" />
                <Button Grid.Column="2" Text="▣ Finanzas" Clicked="OnNavFinanzasClicked" BackgroundColor="Transparent"
                        TextColor="White" CornerRadius="12" FontSize="{OnIdiom Phone=11, Default=14}" HeightRequest="50" Padding="3" />
                <Button Grid.Column="3" Text="▤ Reportes" Clicked="OnReporteClicked" BackgroundColor="Transparent"
                        TextColor="White" CornerRadius="12" FontSize="{OnIdiom Phone=11, Default=14}" HeightRequest="50" Padding="3" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
